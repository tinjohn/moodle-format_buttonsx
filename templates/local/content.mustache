{{!
    @template format_buttonsx/local/content

    ButtonsX course format content template.

    Context variables required for this template:
    * buttonnavdata - Button navigation data object
    * initialsection - Initial section (section 0)
    * sections - Array of section objects
    * format - Format name
    * title - Course title
    * uniqid - Unique ID for this instance
    * sectionreturn - Section return value
}}
<div id="course-format-{{uniqid}}" class="buttonsx-course-format {{^displayh5picons}}buttonsx-hide-h5p{{/displayh5picons}} {{#act_complinfo_position}}buttonsx-completion-left{{/act_complinfo_position}}" data-buttonstyle="{{buttonstyle}}">
    
    {{#buttonnavdata}}
        {{> format_buttonsx/buttonnav }}
    {{/buttonnavdata}}
    
    <h2 class="accesshide">{{{title}}}</h2>
    {{{completionhelp}}}
    
    <ul class="{{format}}" data-for="course_sectionlist" id="coursecontentcollapse">
        {{#initialsection}}
            {{$ core_courseformat/local/content/section }}
                {{> core_courseformat/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/initialsection}}
        {{#sections}}
            {{$ core_courseformat/local/content/section }}
                {{> core_courseformat/local/content/section }}
            {{/ core_courseformat/local/content/section }}
        {{/sections}}
    </ul>
    
    {{#buttonnavdata}}
        {{#showbottommenu}}
        <div id="bottombuttonsectioncontainer" class="{{#iscircle}}circle{{/iscircle}}">
            {{#sections}}
                <a href="#section-{{num}}" 
                   id="bottombuttonsection-{{num}}" 
                   class="buttonsection sectionnotvisible"
                   data-section="{{num}}">
                    {{{text}}}
                </a>
            {{/sections}}
        </div>
        {{/showbottommenu}}
    {{/buttonnavdata}}
    
    {{#numsections}}
        {{^singlesection}}
            {{$ core_courseformat/local/content/addsection}}
                {{> core_courseformat/local/content/addsection}}
            {{/ core_courseformat/local/content/addsection}}
        {{/singlesection}}
    {{/numsections}}
    
    {{#bulkedittools}}
        {{$ core_courseformat/local/content/bulkedittools}}
            {{> core_courseformat/local/content/bulkedittools}}
        {{/ core_courseformat/local/content/bulkedittools}}
    {{/bulkedittools}}

</div>

{{#js}}
require(['core_courseformat/local/content', 'format_buttonsx/section'], function(component, ButtonsXSection) {
    component.init('course-format-{{uniqid}}', {}, {{sectionreturn}});
    ButtonsXSection.init();
});
{{/js}}
