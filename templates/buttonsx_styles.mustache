{{!
    @template format_buttonsx/buttonsx_styles

    ButtonsX format inline styles template.

    Context variables required for this template:
    * course - Course object with format options

    Example context (json):
    {
        "course": {}
    }
}}
<style>
    /* ButtonsX specific styling */
    #buttonsectioncontainer, #bottombuttonsectioncontainer {
        display: table;
        width: 100%;
        margin: 10px 0;
    }
    
    .buttonsection, .bottombuttonsection {
        display: inline-block;
        margin: 5px;
        padding: 10px 15px;
        border-radius: {{#course.buttonstyle}}{{#circle}}50%{{/circle}}{{^circle}}5px{{/circle}}{{/course.buttonstyle}};
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .buttonsection.sectionvisible {
        font-weight: bold;
        {{#course.colorvisible}}
        background: {{{course.colorvisible}}};
        {{/course.colorvisible}}
    }
    
    .buttonsection.current {
        {{#course.colorcurrent}}
        background: {{{course.colorcurrent}}};
        {{/course.colorcurrent}}
    }
    
    .bottombuttonsection.sectionnotvisible {
        opacity: 0.5;
    }
    
    {{^editing}}
    {{^course.displayh5picons}}
    .h5pactivity .activity-instance {
        display: none !important;
    }
    {{/course.displayh5picons}}
    
    {{^course.act_complinfo_position}}
    /* Override grid layout to move completion after altcontent */
    .path-course-view.format-buttonsx .activity-item .activity-grid {
        grid-template-columns: min-content 1fr min-content min-content;
        grid-template-rows: 1fr repeat(6, min-content);
        grid-template-areas: 
            "icon   name          groupmode      actions"
            "icon   visibility    groupmode      actions"
            "icon   dates         groupmode      actions"
            "icon   altcontent    altcontent     altcontent"
            "icon   completion    completion     completion"
            "icon   afterlink     afterlink      afterlink"
            "icon   availability  availability   availability";
    }
    @media (max-width: 575.98px) {
        .path-course-view.format-buttonsx .activity-item .activity-grid {
            grid-template-areas: 
                "icon          name          actions"
                "icon          visibility    actions"
                "dates         dates         dates"
                "groupmode     groupmode     groupmode"
                "altcontent    altcontent    altcontent"
                "completion    completion    completion"
                "afterlink     afterlink     afterlink"
                "availability  availability  availability";
        }
    }
    {{/course.act_complinfo_position}}
    {{/editing}}
    
    .inlinebuttonsections .buttonsection {
        display: inline-flex;
    }
    
    .divisortext {
        font-weight: bold;
        margin: 15px 0 5px 0;
        padding: 10px;
        background: rgba(0,0,0,0.05);
        border-left: 3px solid #007bff;
    }
    
    /* Sequential access styling */
    .buttonsection.sequential-locked {
        opacity: 0.4;
        cursor: not-allowed;
    }
</style>
